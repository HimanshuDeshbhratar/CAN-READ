# CAN Log Narrator — environment configuration
# Copy this file to .env for local development. Never commit .env or real keys.

# ---------------------------------------------------------------- HTTP server
PORT=3001
HOST=127.0.0.1
# Comma-separated list of allowed browser origins. The Vite dev server default
# is included so the local frontend can call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional. Only needed when the frontend is hosted separately from the API.
# Leave empty for the Vite dev proxy and the single-port production build.
VITE_API_BASE_URL=

# ------------------------------------------------------- AI narration (LLM)
# The narration provider is optional. With NARRATION_PROVIDER=none (or an
# unset value) the API always returns a deterministic, evidence-based report
# generated from the analysis itself. No API key is required in that mode.
#
# Supported values for NARRATION_PROVIDER:
#   none              deterministic fallback only (default, no key needed)
#   openai-compatible any chat-completions compatible endpoint
#
# NARRATION_BASE_URL is the API base, without the /chat/completions suffix.
# NARRATION_MODEL is the model identifier passed to the provider.
# NARRATION_API_KEY is sent as a Bearer token; leave empty for local servers
# that do not require authentication (for example a local Ollama instance).
#
# Free / local development example (Ollama, no key required):
#   NARRATION_PROVIDER=openai-compatible
#   NARRATION_BASE_URL=http://localhost:11434/v1
#   NARRATION_API_KEY=
#   NARRATION_MODEL=llama3.2
#
# Hosted example (any compatible gateway):
#   NARRATION_PROVIDER=openai-compatible
#   NARRATION_BASE_URL=https://your-gateway.example/v1
#   NARRATION_API_KEY=replace-me
#   NARRATION_MODEL=your-model-id
NARRATION_PROVIDER=none
NARRATION_BASE_URL=
NARRATION_API_KEY=
NARRATION_MODEL=
# Request timeout for the narration call in milliseconds.
NARRATION_TIMEOUT_MS=60000
